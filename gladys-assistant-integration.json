  "widgets": [
    {
      "key": "twinkly_overview",
      "label": {
        "en": "Twinkly",
        "fr": "Twinkly",
        "de": "Twinkly",
        "es": "Twinkly"
      },
      "description": {
        "en": "Every Twinkly at a glance, or one Twinkly with its brightness, scene, modes and colors.",
        "fr": "Tous les Twinkly d'un coup d'œil, ou un Twinkly avec sa luminosité, ses scènes, modes et couleurs.",
        "de": "Alle Twinkly auf einen Blick oder ein Twinkly mit Helligkeit, Szene, Modi und Farben.",
        "es": "Todos los Twinkly de un vistazo, o un Twinkly con su brillo, escena, modos y colores."
      },
      "icon": "star",
      "action_timeout_seconds": 30,
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Twinkly",
            "fr": "Twinkly",
            "de": "Twinkly",
            "es": "Twinkly"
          },
          "description": {
            "en": "Leave empty to see every Twinkly with the \"All on\" / \"All off\" buttons.",
            "fr": "Laissez vide pour voir tous les Twinkly avec les boutons « Tout allumer » / « Tout éteindre ».",
            "de": "Leer lassen, um alle Twinkly mit den Schaltflächen „Alle ein“ / „Alle aus“ zu sehen.",
            "es": "Déjelo vacío para ver todos los Twinkly con los botones «Encender todo» / «Apagar todo»."
          },
          "required": false
        },
        {
          "key": "buttons",
          "type": "select",
          "label": {
            "en": "Buttons",
            "fr": "Boutons",
            "de": "Schaltflächen",
            "es": "Botones"
          },

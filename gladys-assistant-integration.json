  "scene_actions": [
    {
      "key": "play_movie",
      "label": {
        "en": "Play a Twinkly movie",
        "fr": "Jouer une animation Twinkly",
        "de": "Twinkly-Animation abspielen",
        "es": "Reproducir una animación de Twinkly"
      },
      "description": {
        "en": "Play a movie uploaded from the Twinkly app, by its name or its position in the list.",
        "fr": "Joue une animation chargée depuis l'application Twinkly, par son nom ou sa position dans la liste.",
        "de": "Spielt eine aus der Twinkly-App hochgeladene Animation ab, über ihren Namen oder ihre Position in der Liste.",
        "es": "Reproduce una animación cargada desde la aplicación Twinkly, por su nombre o su posición en la lista."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Twinkly",
            "fr": "Twinkly",
            "de": "Twinkly",
            "es": "Twinkly"
          },
          "required": true
        },
        {
          "key": "movie",
          "type": "string",
          "label": {
            "en": "Movie name (or number)",
            "fr": "Nom de l'animation (ou numéro)",
            "de": "Name der Animation (oder Nummer)",
            "es": "Nombre de la animación (o número)"
          },
          "placeholder": {
            "en": "Snowfall",
            "fr": "Neige",
            "de": "Schneefall",
            "es": "Nevada"
          },
          "required": true
        }

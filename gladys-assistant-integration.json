          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Twinkly",
            "fr": "Twinkly",
            "de": "Twinkly",
            "es": "Twinkly"
          },
          "required": true
        },
        {
          "key": "effect",
          "type": "number",
          "label": {

{
  "manifest_version": 1,
  "type": "device",
  "name": "Twinkly",
  "description": {
    "en": "Control your Twinkly smart LED lights over your local network.",
    "fr": "Pilotez vos guirlandes et lumières LED Twinkly sur votre réseau local.",
    "de": "Steuern Sie Ihre Twinkly-LED-Lichter über Ihr lokales Netzwerk.",
    "es": "Controle sus luces LED inteligentes Twinkly a través de su red local."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/prohand/gladys-twinkly:1.1.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-twinkly/main/cover.png",
  "categories": ["lighting"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "udp-active-broadcast",
      "ports": [5555]
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Set up your Twinkly in the Twinkly app first, on the same network as Gladys. Gladys then drives it locally, without any account or cloud: it finds it by itself (network scan), or you type its IP address below.",
        "fr": "Installez d'abord votre Twinkly avec l'application Twinkly, sur le même réseau que Gladys. Gladys le pilote ensuite en local, sans compte ni cloud : elle le trouve seule (recherche réseau), ou vous saisissez son adresse IP ci-dessous.",
        "de": "Richten Sie Ihr Twinkly zuerst in der Twinkly-App ein, im selben Netzwerk wie Gladys. Gladys steuert es dann lokal, ohne Konto und ohne Cloud: Gladys findet es selbst (Netzwerksuche), oder Sie geben unten seine IP-Adresse ein.",
        "es": "Configure primero su Twinkly con la aplicación Twinkly, en la misma red que Gladys. Después, Gladys lo controla en local, sin cuenta ni nube: lo encuentra por sí sola (búsqueda en la red) o usted introduce su dirección IP a continuación."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-twinkly/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "IP addresses",
        "fr": "Adresses IP",
        "de": "IP-Adressen",
        "es": "Direcciones IP"
      },
      "description": {
        "en": "IP addresses of your Twinkly devices, separated by commas. Optional when the network scan finds them; give them a fixed IP (DHCP reservation) in your router.",
        "fr": "Adresses IP de vos Twinkly, séparées par des virgules. Facultatif si la recherche réseau les trouve ; donnez-leur une IP fixe (réservation DHCP) dans votre box.",
        "de": "IP-Adressen Ihrer Twinkly-Geräte, durch Kommas getrennt. Optional, wenn die Netzwerksuche sie findet; geben Sie ihnen in Ihrem Router eine feste IP (DHCP-Reservierung).",
        "es": "Direcciones IP de sus dispositivos Twinkly, separadas por comas. Opcional si la búsqueda en la red los encuentra; asígneles una IP fija (reserva DHCP) en su router."
      },
      "placeholder": {
        "en": "192.168.1.40, 192.168.1.41",
        "fr": "192.168.1.40, 192.168.1.41",
        "de": "192.168.1.40, 192.168.1.41",
        "es": "192.168.1.40, 192.168.1.41"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "auto_discovery",
      "type": "boolean",
      "label": {
        "en": "Network scan",
        "fr": "Recherche réseau",
        "de": "Netzwerksuche",
        "es": "Búsqueda en la red"
      },
      "description": {
        "en": "Look for Twinkly devices on the network (UDP broadcast on port 5555, sent by Gladys). Turn it off if your network blocks broadcasts and you typed the IP addresses.",
        "fr": "Cherche les Twinkly sur le réseau (diffusion UDP sur le port 5555, émise par Gladys). Désactivez-la si votre réseau bloque la diffusion et que vous avez saisi les adresses IP.",
        "de": "Sucht Twinkly-Geräte im Netzwerk (UDP-Broadcast auf Port 5555, von Gladys gesendet). Deaktivieren Sie sie, wenn Ihr Netzwerk Broadcasts blockiert und Sie die IP-Adressen eingegeben haben.",
        "es": "Busca dispositivos Twinkly en la red (difusión UDP en el puerto 5555, enviada por Gladys). Desactívela si su red bloquea la difusión y ha introducido las direcciones IP."
      },
      "required": false,
      "default": true
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Gladys reads each Twinkly, to follow changes made from the app.",
        "fr": "Fréquence de lecture de chaque Twinkly, pour suivre les changements faits depuis l'application.",
        "de": "Wie oft Gladys jedes Twinkly abfragt, um Änderungen aus der App zu verfolgen.",
        "es": "Frecuencia con la que Gladys lee cada Twinkly, para seguir los cambios hechos desde la aplicación."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        }
      ]
    },
    {
      "key": "turn_on_mode",
      "type": "select",
      "label": {
        "en": "When turned on, play",
        "fr": "À l'allumage, jouer",
        "de": "Beim Einschalten abspielen",
        "es": "Al encender, reproducir"
      },
      "description": {
        "en": "What a Twinkly shows when Gladys turns it on.",
        "fr": "Ce qu'affiche un Twinkly quand Gladys l'allume.",
        "de": "Was ein Twinkly zeigt, wenn Gladys es einschaltet.",
        "es": "Lo que muestra un Twinkly cuando Gladys lo enciende."
      },
      "required": false,
      "default": "last",
      "options": [
        {
          "value": "last",
          "label": {
            "en": "What it played last",
            "fr": "Ce qu'il jouait en dernier",
            "de": "Was zuletzt lief",
            "es": "Lo último que reproducía"
          }
        },
        {
          "value": "movie",
          "label": {
            "en": "The current movie",
            "fr": "L'animation en cours",
            "de": "Die aktuelle Animation",
            "es": "La animación actual"
          }
        },
        {
          "value": "effect",
          "label": {
            "en": "The current effect",
            "fr": "L'effet en cours",
            "de": "Der aktuelle Effekt",
            "es": "El efecto actual"
          }
        },
        {
          "value": "playlist",
          "label": {
            "en": "The playlist",
            "fr": "La playlist",
            "de": "Die Playlist",
            "es": "La lista de reproducción"
          }
        },
        {
          "value": "color",
          "label": {
            "en": "The solid color",
            "fr": "La couleur fixe",
            "de": "Die feste Farbe",
            "es": "El color fijo"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    },
    {
      "key": "identify",
      "label": {
        "en": "Identify a Twinkly",
        "fr": "Identifier un Twinkly",
        "de": "Ein Twinkly identifizieren",
        "es": "Identificar un Twinkly"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Dispositivo"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "mode_changed",
      "label": {
        "en": "A Twinkly changed mode",
        "fr": "Un Twinkly a changé de mode",
        "de": "Ein Twinkly hat den Modus gewechselt",
        "es": "Un Twinkly ha cambiado de modo"
      },
      "description": {
        "en": "What a Twinkly plays changed outside Gladys: from the app, its button or its own timer.",
        "fr": "Ce que joue un Twinkly a changé hors de Gladys : depuis l'application, son bouton ou sa minuterie.",
        "de": "Was ein Twinkly abspielt, hat sich außerhalb von Gladys geändert: über die App, seine Taste oder seinen eigenen Timer.",
        "es": "Lo que reproduce un Twinkly ha cambiado fuera de Gladys: desde la aplicación, su botón o su propio temporizador."
      },
      "fields": [
        {
          "key": "device",
